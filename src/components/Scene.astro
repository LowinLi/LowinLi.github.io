    padding: 10px 14px; color: #fff; background: #10203acc; border: 1px solid #ffffff40; border-radius: 14px; backdrop-filter: blur(6px);
  }
  .timepanel[hidden] { display: none; }
  .timepanel p { margin: 0; font-size: 13px; }
  .tp-time { font: 600 17px ui-monospace, monospace; color: #ffd27a; margin-right: 4px; }
