---
// 首页唯一的 3D island。low 档只显示静态回退，不加载 three.js。
import type { SiteData } from '../scene/types';
import { TAPES } from '../tapes';
interface Props { data: SiteData }
const { data } = Astro.props;
// low 档时磁带按钮退化成页内锚点
const anchors: Record<string, string> = { about: '#about', posts: '#posts' };
---
<section class="scene" data-tier="pending" aria-label="交互式书桌">
  <div class="fallback" aria-hidden="true">
    <div class="tv"><div class="glass"><span>NO SIGNAL</span></div></div>
  </div>
  <canvas aria-hidden="true"></canvas>
  <div class="overlay">
    <div class="intro">
      <h1>{data.name}</h1>
      <p>{data.tagline}</p>
    </div>
    <nav class="tapes" aria-label="磁带">
      {TAPES.map((t) => (
        <a
          href={anchors[t.id] ?? '#'}
          data-tape={t.id}
          data-webgl-only={anchors[t.id] ? undefined : ''}
          style={`--c:${t.color}`}
        >{t.label}</a>
      ))}
    </nav>
    <button class="eject" type="button" hidden>⏏ 退出 <kbd>ESC</kbd></button>
    <p class="hint">点一盘磁带塞进电视</p>
  </div>
  <script type="application/json" id="site-data" set:html={JSON.stringify(data)} />
</section>

<script>
  import { detectTier } from '../scene/tier';

  const root = document.querySelector<HTMLElement>('.scene')!;
  const tier = detectTier();
  root.dataset.tier = tier;
  if (tier !== 'low') {
    const canvas = root.querySelector('canvas')!;
    const data = JSON.parse(document.getElementById('site-data')!.textContent!);
    const eject = root.querySelector<HTMLButtonElement>('.eject')!;
    import('../scene/runtime').then(({ start }) => {
      const { bus } = start(canvas, tier, data);
      root.dataset.ready = 'true';
      const emit = (type: string, detail?: unknown) => bus.dispatchEvent(new CustomEvent(type, { detail }));
      root.querySelectorAll<HTMLAnchorElement>('[data-tape]').forEach((a) => {
        a.addEventListener('click', (e) => { e.preventDefault(); emit('tape:insert', { id: a.dataset.tape }); });
      });
      eject.addEventListener('click', () => emit('tape:eject'));
      bus.addEventListener('tape:state', (e) => {
        const playing = (e as CustomEvent<{ playing: string | null }>).detail.playing;
        root.dataset.playing = playing ?? '';
        eject.hidden = !playing;
        root.querySelectorAll<HTMLElement>('[data-tape]').forEach((a) => a.toggleAttribute('aria-current', a.dataset.tape === playing));
      });
    }).catch((err) => {
      console.error('[scene] 初始化失败，退回静态版', err);
      root.dataset.tier = 'low';
    });
  }
</script>

<style>
  .scene { position: relative; width: 100%; height: 100svh; min-height: 520px; overflow: hidden; background: #0c0907; color: #f1e6d4; }
  canvas, .fallback { position: absolute; inset: 0; width: 100%; height: 100%; }
  canvas { touch-action: pan-y; }
  .fallback {
    display: grid; place-items: center;
    background: radial-gradient(ellipse at 60% 30%, #2b1f2e 0, #0c0907 70%);
    transition: opacity .6s;
  }
  .tv { width: min(64vw, 360px); aspect-ratio: 4/3.2; background: #cfc3ad; border-radius: 18px; padding: 7%; box-shadow: 0 30px 80px #000a; }
  .glass { height: 100%; border-radius: 14px / 18px; background: radial-gradient(ellipse, #2a1608, #0d0703 75%); display: grid; place-items: center;
    font: 700 clamp(14px, 3vw, 20px) ui-monospace, monospace; color: #ffb347; letter-spacing: .1em; text-shadow: 0 0 8px #ffb347; }
  .scene[data-ready='true'] .fallback { opacity: 0; pointer-events: none; }
  .scene[data-tier='low'] canvas { display: none; }
  .scene[data-tier='low'] [data-webgl-only] { display: none; }

  .overlay { position: absolute; inset: 0; pointer-events: none; padding: 16px; display: flex; flex-direction: column; }
  .overlay > * { pointer-events: auto; }
  .intro { max-width: 520px; transition: opacity .4s; }
  .intro h1 { margin: 40px 0 4px; font-size: clamp(28px, 5vw, 44px); letter-spacing: .02em; }
  .intro p { margin: 0; color: #c9b9a0; }
  .scene[data-playing]:not([data-playing='']) .intro,
  .scene[data-playing]:not([data-playing='']) .hint { opacity: 0; pointer-events: none; }
  .tapes { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; }
  .tapes a {
    font-size: 14px; padding: 6px 12px; border-radius: 4px; text-decoration: none; color: #2a1d12;
    background: var(--c); box-shadow: inset 0 -3px 0 #0002;
  }
  .tapes a[aria-current] { outline: 2px solid #ffb347; outline-offset: 2px; }
  .tapes a:focus-visible, .eject:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .hint { margin: 10px 0 0; font-size: 13px; color: #8f8170; }
  .scene[data-tier='low'] .hint { display: none; }
  .eject {
    position: absolute; top: 16px; right: 16px; font: inherit; font-size: 14px; color: #f1e6d4;
    background: #0008; border: 1px solid #f1e6d455; border-radius: 4px; padding: 6px 12px; cursor: pointer;
  }
  .eject[hidden] { display: none; }
  kbd { font: 12px ui-monospace, monospace; opacity: .7; }
  @media (min-width: 900px) { .overlay { padding: 24px 32px; } }
</style>
