---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.astro';
const latest = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---
<Base title="Home">
  <Scene />
  <main class="list">
    <h1>你好，我是 ___</h1>
    <p>一句话介绍。TODO</p>
    <h2>最近文章</h2>
    <ul>
      {latest.map((p) => <li><a href={`/posts/${p.id}/`}>{p.data.title}</a></li>)}
    </ul>
    <p><a href="/posts/">全部文章 →</a></p>
  </main>
</Base>
